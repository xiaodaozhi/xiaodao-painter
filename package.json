{
  "name": "xiaodao-painter",
  "version": "0.1.7",
  "description": "A Vue 3 component for drawing on the canvas",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "vue",
    "canvas",
    "drawing",
    "painter"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/xiaodao-painter.umd.js",
  "module": "./dist/xiaodao-painter.es.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/xiaodao-painter.es.js",
      "require": "./dist/xiaodao-painter.umd.js",
      "types": "./dist/types/index.d.ts"
    },
    "./style.css": "./dist/xiaodao-painter.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vue-tsc -p tsconfig.app.json",
    "typecheck": "vue-tsc --noEmit",
    "lint:check": "eslint .",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.8.1",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.0",
    "vue": "^3.5.40",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.8"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaodaozhi/xiaodao-painter.git"
  }
}
